DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
NEXTAUTH_SECRET="your-secret-here-run-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Emacrescere"

# ─── LiveKit (videochamada) ────────────────────────────────────────────────────
# LIVEKIT_URL é usada no servidor (geração de token); NEXT_PUBLIC_LIVEKIT_URL é a
# mesma URL exposta ao cliente e também entra na Content-Security-Policy — sem
# ela o navegador bloqueia a conexão WebSocket da chamada em produção.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=

# ─── E-mail transacional (recuperação de senha) — Resend ─────────────────────
# Criar conta gratuita em https://resend.com, gerar API key.
# EMAIL_FROM precisa ser um remetente verificado no Resend (ou use o domínio
# de teste onboarding@resend.dev enquanto não verifica um domínio próprio).
RESEND_API_KEY=
EMAIL_FROM="Emacrescere <onboarding@resend.dev>"

# ─── Login com Facebook (OAuth) ───────────────────────────────────────────────
# Criar app em https://developers.facebook.com, produto "Facebook Login".
# Callback URL a configurar no app: {NEXTAUTH_URL}/api/auth/callback/facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ─── Pagamentos (Asaas) ─────────────────────────────────────────────────────
# ASAAS_API_URL: deixe em branco para usar o sandbox por padrão.
# ASAAS_WEBHOOK_TOKEN: token que você define e configura também no painel Asaas,
# usado para validar que o webhook recebido é legítimo.
# PAYMENT_MOCK=true simula pagamento aprovado em dev, sem chamar a Asaas de verdade.
ASAAS_API_URL=
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
PAYMENT_MOCK=true

# ─── Armazenamento de arquivos (S3-compatível — Contabo Object Storage) ──────
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_PREFIX=

# ─── Assinatura digital (certificado .pfx do médico, ICP-Brasil) ────────────
# 32 bytes em hexadecimal (64 caracteres). Gerar com: openssl rand -hex 32
PFX_ENCRYPTION_KEY=
