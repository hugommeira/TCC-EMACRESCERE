DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
NEXTAUTH_SECRET="your-secret-here-run-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="TeleMed"
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ─── E-mail transacional (recuperação de senha) — Resend ─────────────────────
# Criar conta gratuita em https://resend.com, gerar API key.
# EMAIL_FROM precisa ser um remetente verificado no Resend (ou use o domínio
# de teste onboarding@resend.dev enquanto não verifica um domínio próprio).
RESEND_API_KEY=
EMAIL_FROM="TeleMed <onboarding@resend.dev>"

# ─── Login com Facebook (OAuth) ───────────────────────────────────────────────
# Criar app em https://developers.facebook.com, produto "Facebook Login".
# Callback URL a configurar no app: {NEXTAUTH_URL}/api/auth/callback/facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=